# Copy to prod.hcl and run:
#   terraform init -backend-config=backend/prod.hcl
#
# The state bucket and lock table are bootstrapped outside this stack so that
# destroying the stack can never destroy its own state.

bucket       = "your-terraform-state-bucket"
key          = "ai-log-investigator/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
